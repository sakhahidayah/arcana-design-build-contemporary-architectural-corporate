{
  "name": "arkana-design-build",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": { "node": "^22.23.4 || >=24.22.1", "pnpm": "10.x" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "payload": "node --env-file=.env.local --import tsx node_modules/payload/bin.js",
    "setup:env": "node scripts/setup-env.mjs",
    "check:db": "node --env-file=.env.local --import tsx scripts/check-db.ts",
    "test": "node --test tests/setup.test.mjs",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "graphql": "16.11.0",
    "next": "16.4.5",
    "payload": "3.93.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
